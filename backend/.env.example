# Application
APP_NAME=airhost-api
APP_ENV=development

# HTTP
HTTP_PORT=8081
HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=airhost
DB_PASSWORD=airhost
DB_NAME=airhost
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIGRATIONS_PATH=internal/infrastructure/persistence/postgres/migrations

# Pricing
SERVICE_FEE_RATE=0.12

# Keycloak (OIDC)
KEYCLOAK_ISSUER=http://localhost:8080/realms/airhost
KEYCLOAK_CLIENT_ID=airhost-api

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=airhost-media
MINIO_USE_SSL=false
MINIO_PUBLIC_HOST=http://localhost:9000
