# Vite reads VITE_-prefixed variables at build/dev time. These are browser-facing
# URLs, so they must use host-published ports (localhost), not Docker service names.
VITE_API_BASE_URL=http://localhost:8081/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=airhost
VITE_KEYCLOAK_CLIENT_ID=airhost-web
